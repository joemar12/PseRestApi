{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "PseRestApi": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/pseapi-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "PseApiConfig": {
    "FramesUrl": "https://frames.pse.com.ph/",
    "Referrer": "https://www1.pse.com.ph/stockMarket/home.html"
  },
  "RateLimitConfig": {
    "PermitLimit": 10,
    "WindowInMinutes": 1
  },
  "ConnectionStrings": {
    "DefaultConnectionString": ""
  },
  "AllowedHosts": "*"
}